{
  "name": "@cwchanap/bevy-plugin",
  "version": "0.1.0",
  "description": "Agent-plugin distribution wrapper for the Bevy BRP MCP and bevy-mcp bridge.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "bevy-plugin": "build/index.js"
  },
  "files": [
    "build",
    "plugin.json",
    "mcp.json"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run typecheck && tsc -p tsconfig.build.json",
    "test": "tsc -p tsconfig.test.json && node --test .test-build/test/*.test.js",
    "test:integration": "npm run build && node scripts/integration.mjs",
    "smoke:packed": "node scripts/smoke-packed-cli.mjs",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "^20.11.24",
    "typescript": "^5.3.3"
  }
}
